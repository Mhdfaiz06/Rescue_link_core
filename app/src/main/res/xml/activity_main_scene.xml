<?xml version="1.0" encoding="utf-8"?>
<MotionScene
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:motion="http://schemas.android.com/apk/res-auto">

    <Transition
        motion:constraintSetEnd="@+id/map_opened"
        motion:constraintSetStart="@id/map_closed"
        motion:duration="400">

        <OnSwipe
            motion:touchRegionId="@id/map_box_handle"
            motion:dragDirection="dragUp"
            motion:touchAnchorId="@id/map_box_container"
            motion:touchAnchorSide="top" />
    </Transition>

    <ConstraintSet android:id="@+id/map_closed">
        <Constraint
            android:id="@+id/log_box_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toTopOf="@+id/chat_input_container"
            motion:layout_constraintTop_toBottomOf="@+id/statusBanner"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@+id/map_box_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toBottomOf="@+id/log_box_container"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent"
            motion:layout_constraintHeight_percent="0.05" /> </ConstraintSet>

    <ConstraintSet android:id="@+id/map_opened">

        <Constraint
            android:id="@+id/log_box_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginBottom="8dp"
            motion:layout_constraintBottom_toTopOf="@+id/map_box_container"
            motion:layout_constraintTop_toBottomOf="@+id/statusBanner"
            motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent" />

        <Constraint
            android:id="@+id/map_box_container"
            android:layout_width="0dp"
            android:layout_height="0dp"
            motion:layout_constraintBottom_toTopOf="@+id/chat_input_container"
            motion:layout_constraintTop_toBottomOf="@+id/statusBanner"
            android:layout_marginTop="150dp"  motion:layout_constraintStart_toStartOf="parent"
            motion:layout_constraintEnd_toEndOf="parent" />
    </ConstraintSet>
</MotionScene>